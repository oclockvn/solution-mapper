<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SolutionMapper</AssemblyName>
    <RootNamespace>SolutionMapper</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>SolutionMapper</ToolCommandName>
    <PackageId>SolutionMapper</PackageId>
    <Authors>ocloc</Authors>
    <Description>Map matching .NET projects across legacy vs upgraded solution trees and open them in a diff tool (read-only).</Description>
    <PackageTags>dotnet;tool;diff;migration</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

</Project>
